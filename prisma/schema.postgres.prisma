// Prisma Schema for Subscription Trimmer - Production (PostgreSQL)
// Deploy with: prisma db push --schema prisma/schema.postgres.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum BankProvider {
  PLAID
  MX
  MOCK
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  EVERY_2_MONTHS
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  IRREGULAR
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum UserSubscriptionDecision {
  KEEP
  REVIEW
  CANCEL
}

enum CancellationStatus {
  NOT_STARTED
  GUIDED
  MESSAGE_GENERATED
  USER_SENT
  REQUESTED
  PROCESSING
  CONFIRMED
  FAILED
  NEEDS_USER_ACTION
}

enum CancellationMethod {
  GUIDED_LINK
  AI_EMAIL
  CERTIFIED_MAIL
  CONCIERGE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
  ADMIN
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  Role                   @default(USER)
  googleId              String?                @unique
  avatarUrl             String?
  emailVerified         Boolean                @default(false)
  mfaEnabled            Boolean                @default(false)
  mfaSecret             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  profile               UserProfile?
  bankConnections       BankConnection[]
  subscriptions         Subscription[]
  subscriptionOverrides SubscriptionOverride[]
  cancellationRequests  CancellationRequest[]
  auditLogs             AuditLog[]
  billingCustomer       BillingCustomer?
  billingSubscriptions  BillingSubscription[]
  payments              Payment[]
  apiKeys               ApiKey[]
  webhooks              WebhookEndpoint[]
  notifications         Notification[]
  savedCards            SavedCard[]
  budgets               Budget[]
  goals                 SavingsGoal[]
  alerts                PriceAlert[]
  reports               SpendingReport[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency    String   @default("USD")
  timezone    String   @default("America/New_York")
  phoneNumber String?
  addressJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankConnection {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             BankProvider     @default(MOCK)
  providerConnectionId String
  accessTokenEncrypted String
  status               ConnectionStatus @default(CONNECTED)
  institutionName      String           @default("Chase Bank")
  institutionLogo      String?
  lastSyncAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  accounts             BankAccount[]

  @@index([userId, status])
}

model BankAccount {
  id                  String         @id @default(uuid())
  connectionId        String
  bankConnection      BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name                String
  officialName        String?
  maskedAccountNumber String
  type                AccountType    @default(CHECKING)
  currency            String         @default("USD")
  balanceCurrent      Float          @default(0.0)
  balanceAvailable    Float?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  transactions        Transaction[]

  @@index([connectionId])
}

model Merchant {
  id                       String          @id @default(uuid())
  normalizedName           String          @unique
  category                 String          @default("Entertainment")
  website                  String?
  logoUrl                  String?
  cancellationUrl          String?
  cancellationPhone        String?
  cancellationEmail        String?
  cancellationInstructions String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  aliases                  MerchantAlias[]
  transactions             Transaction[]
  subscriptions            Subscription[]
  overrides                SubscriptionOverride[]

  @@index([normalizedName])
}

model MerchantAlias {
  id         String   @id @default(uuid())
  alias      String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                    String      @id @default(uuid())
  accountId             String
  bankAccount           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerTransactionId String      @unique
  amount                Float
  currency              String      @default("USD")
  date                  DateTime
  rawDescription        String
  cleanDescription      String
  merchantId            String?
  merchant              Merchant?   @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category              String      @default("Uncategorized")
  isPending             Boolean     @default(false)
  createdAt             DateTime    @default(now())

  @@index([accountId, date])
}

model Subscription {
  id                   String                   @id @default(uuid())
  userId               String
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId           String
  merchant             Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String                   @default("USD")
  frequency            SubscriptionFrequency    @default(MONTHLY)
  confidenceScore      Float                    @default(0.85)
  status               SubscriptionStatus       @default(ACTIVE)
  userStatus           UserSubscriptionDecision @default(REVIEW)
  nextBillingDate      DateTime?
  lastBillingDate      DateTime
  annualizedCost       Float
  monthlyCost          Float
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  cancellationRequests CancellationRequest[]

  @@unique([userId, merchantId])
  @@index([userId, status])
}

model SubscriptionOverride {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId      String
  merchant        Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  isSubscription  Boolean               @default(false)
  customCategory  String?
  customFrequency SubscriptionFrequency?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([userId, merchantId])
}

model CancellationRequest {
  id               String             @id @default(uuid())
  subscriptionId   String
  subscription     Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           CancellationStatus @default(NOT_STARTED)
  method           CancellationMethod @default(AI_EMAIL)
  generatedContent String?
  userNotes        String?
  authorizedAt     DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId, status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  ipAddress    String   @default("127.0.0.1")
  metadataJson String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model BillingCustomer {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  stripePriceId String   @unique
  tier          String   @default("FREE")
  priceMonthly  Float    @default(0.0)
  featuresJson  String
  createdAt     DateTime @default(now())

  subscriptions BillingSubscription[]
}

model BillingSubscription {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String   @unique
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  status               String   @default("active")
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Payment {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String   @unique
  amount                Float
  currency              String   @default("USD")
  status                String   @default("succeeded")
  createdAt             DateTime @default(now())

  @@index([userId])
}

// ============ API Key System ============
model ApiKey {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String        @unique // e.g. "st_live_abc123"
  keyHash    String        @unique // SHA-256 hash of the full key
  scopes     ApiKeyScope[] @default([READ_ONLY])
  status     ApiKeyStatus  @default(ACTIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  rateLimit  Int           @default(100) // requests per minute
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  revokedAt  DateTime?

  usageLogs  ApiKeyUsageLog[]

  @@index([userId, status])
  @@index([keyPrefix])
}

model ApiKeyUsageLog {
  id        String   @id @default(uuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint  String
  method    String
  status    Int
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
}

// ============ Webhook System ============
model WebhookEndpoint {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[] // e.g. ["subscription.created", "subscription.cancelled"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id             String          @id @default(uuid())
  webhookId      String
  webhook        WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payloadJson    String
  status         String          @default("pending") // pending, delivered, failed
  responseStatus Int?
  attempts       Int             @default(0)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([webhookId, status])
}

// ============ Notifications ============
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "subscription", "cancellation", "billing", "system"
  title     String
  body      String
  read      Boolean  @default(false)
  dataJson  String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============ Saved Cards (Privacy Virtual Cards) ============
model SavedCard {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardName    String
  last4       String
  brand       String   @default("VISA")
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ============ Budgets ============
model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  spent     Float    @default(0.0)
  period    String   @default("MONTHLY") // MONTHLY, WEEKLY, YEARLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, period])
  @@index([userId])
}

// ============ Savings Goals ============
model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float    @default(0.0)
  deadline      DateTime?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ============ Price Alerts ============
model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  threshold   Float
  direction   String    @default("INCREASE") // INCREASE, DECREASE
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isActive])
}

// ============ Spending Reports ============
model SpendingReport {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String   // "2026-08", "2026-Q3", "2026"
  type        String   // "MONTHLY", "QUARTERLY", "ANNUAL"
  summaryJson String
  createdAt   DateTime @default(now())

  @@unique([userId, period])
  @@index([userId])
}