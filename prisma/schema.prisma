generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  Role                   @default(USER)
  googleId              String?                @unique
  avatarUrl             String?
  emailVerified         Boolean                @default(false)
  mfaEnabled            Boolean                @default(false)
  mfaSecret             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  bankConnections       BankConnection[]
  billingCustomer       BillingCustomer?
  billingSubscriptions  BillingSubscription[]
  budgets               Budget[]
  cancellationRequests  CancellationRequest[]
  notifications         Notification[]
  payments              Payment[]
  alerts                PriceAlert[]
  savedCards            SavedCard[]
  goals                 SavingsGoal[]
  reports               SpendingReport[]
  subscriptions         Subscription[]
  subscriptionOverrides SubscriptionOverride[]
  profile               UserProfile?
  webhooks              WebhookEndpoint[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  currency    String   @default("USD")
  timezone    String   @default("America/New_York")
  phoneNumber String?
  addressJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankConnection {
  id                   String           @id @default(uuid())
  userId               String
  provider             BankProvider     @default(MOCK)
  providerConnectionId String
  accessTokenEncrypted String
  status               ConnectionStatus @default(CONNECTED)
  institutionName      String           @default("Chase Bank")
  institutionLogo      String?
  lastSyncAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  accounts             BankAccount[]
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model BankAccount {
  id                  String         @id @default(uuid())
  connectionId        String
  name                String
  officialName        String?
  maskedAccountNumber String
  type                AccountType    @default(CHECKING)
  currency            String         @default("USD")
  balanceCurrent      Float          @default(0.0)
  balanceAvailable    Float?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bankConnection      BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@index([connectionId])
}

model Merchant {
  id                       String                 @id @default(uuid())
  normalizedName           String                 @unique
  category                 String                 @default("Entertainment")
  website                  String?
  logoUrl                  String?
  cancellationUrl          String?
  cancellationPhone        String?
  cancellationEmail        String?
  cancellationInstructions String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  aliases                  MerchantAlias[]
  priceAlerts              PriceAlert[]
  subscriptions            Subscription[]
  overrides                SubscriptionOverride[]
  transactions             Transaction[]

  @@index([normalizedName])
}

model MerchantAlias {
  id         String   @id @default(uuid())
  alias      String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                    String      @id @default(uuid())
  accountId             String
  providerTransactionId String      @unique
  amount                Float
  currency              String      @default("USD")
  date                  DateTime
  rawDescription        String
  cleanDescription      String
  merchantId            String?
  category              String      @default("Uncategorized")
  isPending             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  bankAccount           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  merchant              Merchant?   @relation(fields: [merchantId], references: [id])

  @@index([accountId, date])
}

model Subscription {
  id                   String                   @id @default(uuid())
  userId               String
  merchantId           String
  amount               Float
  currency             String                   @default("USD")
  frequency            SubscriptionFrequency    @default(MONTHLY)
  confidenceScore      Float                    @default(0.85)
  status               SubscriptionStatus       @default(ACTIVE)
  userStatus           UserSubscriptionDecision @default(REVIEW)
  nextBillingDate      DateTime?
  lastBillingDate      DateTime
  annualizedCost       Float
  monthlyCost          Float
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  cancellationRequests CancellationRequest[]
  merchant             Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([userId, status])
}

model SubscriptionOverride {
  id              String                 @id @default(uuid())
  userId          String
  merchantId      String
  isSubscription  Boolean                @default(false)
  customCategory  String?
  customFrequency SubscriptionFrequency?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  merchant        Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
}

model CancellationRequest {
  id               String             @id @default(uuid())
  subscriptionId   String
  userId           String
  status           CancellationStatus @default(NOT_STARTED)
  method           CancellationMethod @default(AI_EMAIL)
  generatedContent String?
  userNotes        String?
  authorizedAt     DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subscription     Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resource     String
  ipAddress    String   @default("127.0.0.1")
  metadataJson String?
  timestamp    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}

model BillingCustomer {
  id               String   @id @default(uuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String                @id @default(uuid())
  name          String
  stripePriceId String                @unique
  tier          String                @default("FREE")
  priceMonthly  Float                 @default(0.0)
  featuresJson  String
  createdAt     DateTime              @default(now())
  subscriptions BillingSubscription[]
}

model BillingSubscription {
  id                   String   @id @default(uuid())
  userId               String
  stripeSubscriptionId String   @unique
  planId               String
  status               String   @default("active")
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  plan                 Plan     @relation(fields: [planId], references: [id])
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                    String   @id @default(uuid())
  userId                String
  stripePaymentIntentId String   @unique
  amount                Float
  currency              String   @default("USD")
  status                String   @default("succeeded")
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id         String           @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String           @unique
  keyHash    String           @unique
  scopes     String           @default("READ_ONLY")
  status     ApiKeyStatus     @default(ACTIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  rateLimit  Int              @default(100)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  revokedAt  DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs  ApiKeyUsageLog[]

  @@index([userId, status])
  @@index([keyPrefix])
}

model ApiKeyUsageLog {
  id        String   @id @default(uuid())
  apiKeyId  String
  endpoint  String
  method    String
  status    Int
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
}

model WebhookEndpoint {
  id         String            @id @default(uuid())
  userId     String
  url        String
  secret     String
  events     String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookDelivery {
  id             String          @id @default(uuid())
  webhookId      String
  event          String
  payloadJson    String
  status         String          @default("pending")
  responseStatus Int?
  attempts       Int             @default(0)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  webhook        WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  dataJson  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model SavedCard {
  id          String   @id @default(uuid())
  userId      String
  cardName    String
  last4       String
  brand       String   @default("VISA")
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  amount    Float
  spent     Float    @default(0.0)
  period    String   @default("MONTHLY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, period])
  @@index([userId])
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0.0)
  deadline      DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  merchantId  String?
  threshold   Float
  direction   String    @default("INCREASE")
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model SpendingReport {
  id          String   @id @default(uuid())
  userId      String
  period      String
  type        String
  summaryJson String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum BankProvider {
  PLAID
  MX
  MOCK
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  EVERY_2_MONTHS
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  IRREGULAR
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum UserSubscriptionDecision {
  KEEP
  REVIEW
  CANCEL
}

enum CancellationStatus {
  NOT_STARTED
  GUIDED
  MESSAGE_GENERATED
  USER_SENT
  REQUESTED
  PROCESSING
  CONFIRMED
  FAILED
  NEEDS_USER_ACTION
}

enum CancellationMethod {
  GUIDED_LINK
  AI_EMAIL
  CERTIFIED_MAIL
  CONCIERGE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
  ADMIN
}
