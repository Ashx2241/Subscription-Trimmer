# =============================================================================
# Subscription Trimmer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — uncomment and replace:
# DATABASE_URL="postgresql://user:password@host:5432/subscription_trimmer?schema=public"

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Production (e.g. on Vercel): NEXT_PUBLIC_APP_URL="https://subscription-trimmer-six.vercel.app"
# Local Development: NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Authentication ───────────────────────────────────────────────────────────
# Used to sign JWT session tokens. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Authorized Redirect URI in Google Cloud Console MUST match:
# Production: https://<your-vercel-domain>/api/auth/callback/google
# Local: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional explicit override:
# GOOGLE_REDIRECT_URI="https://your-production-domain.vercel.app/api/auth/callback/google"

# ─── Stripe Billing (optional) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── OpenAI / AI Provider (optional) ──────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Email Provider (optional) ────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ─── Plaid Open Banking (optional) ────────────────────────────────────────────
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"